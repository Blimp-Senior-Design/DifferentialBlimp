<mujoco>

  <compiler assetdir="assets" />

  <option gravity="0 0 -9.8"  density="1.225" viscosity="1.8e-5" >
    <flag contact="enable"/>
  </option>

  <default>
    <motor ctrlrange="-1 1" />
    <default class="imported">
      <mesh scale="0.001 0.001 0.001" />
    </default>


    <default class="balloon">
    <geom density="0.167" fluidshape="ellipsoid" />
    </default>

    </default>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-20" elevation="-20" ellipsoidinertia="true" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
      height="30720" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2" />
    <mesh file="QuadProp.obj" class="imported"/>

 </asset>


  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />
  </worldbody>


  <worldbody>
    <body gravcomp="1" pos="0 0 1">
      <freejoint />
      <geom name="mylar" type="ellipsoid" size="1 0.45 0.21" rgba="0.6 0 0 1" />


      <body pos="0 0 -0.21">
        <geom name="board" type="box" size="0.004 0.5 0.004"  />
      <!-- <geom name="board" type="box" size="0.004 0.5 0.004"  mass="1"/> -->
        <body name = "gurard1" pos = "0 -0.55 -0.009">
        <joint axis="0 1 0" name="servo1" pos="0.0 0.0 0.0" range="0 90" damping="0.003" type="hinge"/>
        <geom type="mesh" mesh="QuadProp"   euler = "180 0 60"  mass="0.01"/>
        <body name="prop1">
          <joint axis = "0 1 0" name="propeller1" damping="0.003" type="hinge"/>
          <geom type="ellipsoid" size="0.02 0.002 0.0001"/>
          <site name="thrust1" pos="0 0 0.008" />
        </body>

        </body>
      <body name = "guard2" pos = "0 0.55 -0.009">
        <joint axis="0 1 0" name="servo2" pos="0.0 0.0 0.0" range="0 90" damping="0.003" type="hinge"/>
        <geom type="mesh" mesh="QuadProp" euler = "180 0 -120" mass="0.01" />
        <body name="prop2">
          <joint axis = "0 1 0" name="propeller2" damping="0.003" type="hinge"/>
          <geom type="ellipsoid" size="0.02 0.002 0.0001" />
          <site name="thrust2" pos="0 0 0" />
        </body>
      </body>

    </body>
    </body>
    </worldbody>



  <actuator>

    <motor ctrllimited="true" ctrlrange="-1 1" joint="servo1" gear=".5"/>
    <motor ctrllimited="true" ctrlrange="-1 1" joint="servo2" gear=".5"/>
    <motor site="thrust1"  gear="0 0 1 0 0 .0201" ctrlrange="-1 1"/>
    <motor site="thrust2" gear="0 0 1 0 0 .0201" ctrlrange="-1 1"/>

  </actuator>


</mujoco>
